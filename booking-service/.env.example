# .env.example
# Template for booking-service's local environment variables.
# Copy this to .env (gitignored) and fill in real values.

# --- Postgres (a dedicated role/database on the same Postgres instance
#     the other services use) ---
# DB_PORT=5434, not the default 5432 - that's the Dockerized postgres
# container's host-mapped port (native Postgres installs on this machine
# occupy 5432/5433 instead). See the other services' .env files for the same
# note - this only matters when running natively (spring-boot:run); Docker
# Compose overrides DB_HOST/DB_PORT to reach the container directly instead.
DB_PORT=5434
DB_NAME=booking_service_db
DB_USERNAME=booking_service
DB_PASSWORD=change-me

# --- JWT (consumed by application.properties) ---
# MUST be the exact same value as auth-service's JWT_SECRET - this service
# only validates tokens auth-service issues, it never signs its own.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# --- Inter-service URLs - only needed when running natively; docker-compose
#     overrides both to the Compose service hostnames instead ---
HOTEL_SERVICE_URL=http://localhost:8083
FLIGHT_SERVICE_URL=http://localhost:8084
