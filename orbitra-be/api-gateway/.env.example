# .env.example
# Template for api-gateway's local environment variables.
# Copy this to .env (gitignored) and fill in real values.

# --- JWT (consumed by application.properties) ---
# MUST be the exact same value as every other service's JWT_SECRET - this
# is the defense-in-depth check at the Gateway, on top of each service's
# own validation, not instead of it.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# --- Eureka - only needed when running natively; docker-compose overrides
#     this to the Compose service hostname instead ---
EUREKA_URL=http://localhost:8761/eureka

# --- Rate limiting (RateLimiterService) - optional, both default as shown ---
# Bucket capacity per client IP, and how many seconds it takes to fully
# refill from empty.
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_SECONDS=60

# --- CORS (globalcors in application.yml) - optional, defaults to the
#     Angular dev server's origin. Change if the frontend runs elsewhere. ---
ALLOWED_ORIGINS=http://localhost:4200
